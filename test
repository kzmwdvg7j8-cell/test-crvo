$('#nmo').textContent='…';try{const t=await sample(`Mélange émotionnel : ${m.mix.map(x=>x[1]+' % '+x[0]).join(', ')} ; valence ${Math.round(m.val*100)} %, activation ${Math.round(m.ar*100)} %. Donne le mot français le plus précis (ou deux mots) pour ce ressenti, puis une phrase d'explication. Format : MOT — explication.`);$('#nmo').textContent=t.text}catch(x){$('#nmo').textContent='Échec ('+(x&&x.code||'erreur')+').'}};
