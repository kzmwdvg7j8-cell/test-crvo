let EF={},MUL=1,sel=null,T=null,sample=null;const v={};R.forEach(r=>v[r.k]=50);
const ORD=['dopa','s1a','gaba','ne','mu','oxt','nmda','cb1','gr','ach','s2a','mt','ox','h1','d2','d1','kap','ado','crh','npy'];
R.sort((a,b)=>{const i=ORD.indexOf(a.k),j=ORD.indexOf(b.k);return(i<0?99:i)-(j<0?99:j)});
let on=new Set(ORD.slice(0,10));
const A=()=>R.filter(r=>on.has(r.k)),fix=()=>R.forEach(r=>{if(!on.has(r.k))v[r.k]=50});
const vv=k=>50+MUL*(v[k]-50),d=k=>((EF[k]??50)-50)/50,col=x=>x>0?'var(--hi)':'var(--lo)';
function eff(){EF={};R.forEach(r=>EF[r.k]=vv(r.k));IX.forEach(([a,b,g])=>{if(on.has(a)&&on.has(b))EF[b]=Math.max(0,Math.min(100,EF[b]+g*(EF[a]-50)))})}
function rv(id){const a=R.filter(r=>r.r.includes(id)&&on.has(r.k));return a.length?a.reduce((s,r)=>s+d(r.k),0)/a.length:0}
const ORDE=['joie','tendresse','sérénité','surprise','peur','colère','tristesse','dégoût'];
const W1={joie:['contentement','joie','euphorie'],peur:['inquiétude','peur','terreur'],colère:['irritation','colère','rage'],tristesse:['mélancolie','tristesse','chagrin profond'],dégoût:['gêne','dégoût','répulsion'],surprise:['étonnement','surprise','stupeur'],tendresse:['sympathie','tendresse','amour'],sérénité:['détente','sérénité','plénitude']};
const W2={'joie+tendresse':'amour, bonheur chaleureux','joie+sérénité':'contentement paisible','joie+surprise':'émerveillement','joie+peur':'excitation anxieuse (frisson, adrénaline)','joie+colère':'exaltation combative','joie+tristesse':'mélancolie douce, nostalgie','tendresse+tristesse':'compassion, chagrin tendre','tendresse+peur':'inquiétude protectrice','sérénité+tristesse':'résignation paisible','surprise+peur':'effroi, sursaut','peur+colère':'rage défensive','peur+tristesse':'angoisse, désespoir','peur+dégoût':'répulsion apeurée','colère+tristesse':'amertume, frustration','colère+dégoût':'mépris','tristesse+dégoût':'écœurement, dégoût de soi'};
function calc(){eff();const s={},M={};for(const e in E){s[e]=0;M[e]=0}
A().forEach(r=>{const x=d(r.k);for(const e in r.w){s[e]+=r.w[e]*x;M[e]+=Math.abs(r.w[e])}});
const c=x=>Math.max(0,Math.min(1,x)),q={};for(const e in E)q[e]=c(s[e]/Math.max(.8,Math.min(M[e],1.6)));
const pos=k=>on.has(k)?Math.max(0,d(k)):0,neg=k=>on.has(k)?Math.max(0,-d(k)):0,g=(a,b)=>Math.sqrt(a*b);
q.eup=Math.max(q.eup,g(pos('dopa'),pos('mu'))*(1-.6*pos('kap')));q.att=Math.max(q.att,g(pos('oxt'),pos('dopa')));
const B={joie:c(q.eup+.3*q.att+.15*q.mot-.5*q.dep-.4*q.anx),peur:c(.9*q.anx+.4*q.vig+.3*q.str-.5*q.cal-.3*q.eup),colère:c(.5*q.str+.5*pos('v1a')+.3*pos('ar')+.3*q.vig-.4*q.cal-.3*q.att),tristesse:c(.9*q.dep+.3*q.leth+.3*q.dys-.6*q.eup),dégoût:c(.7*q.dys+.5*pos('ht3')),surprise:c(.6*q.vig+.4*pos('ach')+.3*pos('a1')-.3*q.leth),tendresse:c(q.att+.2*q.cal),sérénité:c(q.cal-.5*q.anx-.3*q.str)};
const l=Object.entries(B).filter(x=>x[1]>=.15).sort((a,b)=>b[1]-a[1]),tot=l.reduce((a,x)=>a+x[1],0);
const mix=l.map(x=>[x[0],Math.round(x[1]/tot*100),x[1]]);
const ps=B.joie+B.tendresse+B.sérénité,ng=B.peur+B.colère+B.tristesse+B.dégoût;
const sy=[['Palpitations, cœur rapide',c(.6*pos('ne')+.5*pos('b')+.3*pos('crh'))],['Tension musculaire',c(.5*q.str+.5*neg('gaba'))],['Somnolence, fatigue',q.leth],['Douleur',q.dou],['Nausée, malaise',c(.6*q.dys+.6*pos('ht3'))],['Sueurs, frissons',c(.5*pos('ne')+.4*pos('gr'))]].filter(x=>x[1]>=.15);
return{mix,int:Math.round(100*(l[0]?l[0][1]:0)),val:Math.max(-1,Math.min(1,(ps-ng)/1.5)),ar:Math.max(-1,Math.min(1,(q.vig+q.str+q.mot+.5*q.anx-q.leth-q.cal)/1.5)),sy}}
function word(m){const[a,b]=m.mix,lv=x=>x>=.85?2:x>=.5?1:0;
if(b&&b[2]/a[2]>=.5){const k=[a[0],b[0]].sort((x,y)=>ORDE.indexOf(x)-ORDE.indexOf(y)).join('+');if(W2[k])return W2[k]}
return W1[a[0]][lv(a[2])]}
const gauge=(a,b,p)=>`<div class="gx"><span>${a}</span><div class="g"><i style="left:${Math.round(p*100)}%"></i></div><span>${b}</span></div>`;
function det(r){const x=v[r.k],t=Math.abs(x-50)<10?'niveau de repos, pas d’effet marqué':x>50?'plus actif : '+r.hi:'moins actif : '+r.lo;
const ix=IX.filter(i=>i[0]==r.k||i[1]==r.k).map(i=>'• '+i[3]).join('<br>');
return `<b>Où :</b> ${r.r.map(id=>G[id][0]).join(', ')}.<br><b>Rôle :</b> plus actif → ${r.hi} ; moins actif → ${r.lo}.<br><b>À ${x} % :</b> ${t}.`+(ix?`<br><b>Interactions :</b><br>${ix}`:'')+(r.k=='d2'?'<br><b>Repère publié :</b> sous antagoniste, 65 % d’occupation = réponse antipsychotique, environ 80 % = effets moteurs (Kapur 2000).':'')}
function render(){const m=calc();
$('#bm').textContent=m.mix.length?m.mix.map(x=>x[1]+' % '+x[0]).join(' · '):'Aucun ressenti marqué';$('#bw').textContent=m.mix.length?'« '+word(m)+' »':'';
$('#mix').innerHTML=(m.mix.map(x=>`<div class="row"><span>${x[0]}</span><b>${x[1]} %</b></div><div class="bar"><i style="width:${x[1]}%"></i></div>`).join('')||'<div class="mut">Choisis des sensations puis touche Analyser, ou règle les récepteurs.</div>')+(m.mix.length?`<div class="row"><span>Intensité globale</span><b>${m.int} %</b></div>`:'');
$('#va').innerHTML=gauge('Désagréable','Agréable',(m.val+1)/2)+gauge('Calme','Excité',(m.ar+1)/2);
$('#sy').innerHTML=m.sy.map(x=>`<div class="row"><span>${x[0]}</span><b>${Math.round(x[1]*100)} %</b></div>`).join('')||'<div class="mut">Aucun symptôme marqué.</div>';
A().forEach(r=>{const e=$('#v_'+r.k);if(!e)return;e.textContent=v[r.k]+' %'+(Math.abs(EF[r.k]-v[r.k])>=3?' → '+Math.round(EF[r.k])+' %':'');const dd=$('#d_'+r.k);if(!dd.classList.contains('hide'))dd.innerHTML=det(r)});
if(T)drawMap()}
function drawMap(){upd3();const rs=R.filter(r=>sel&&r.r.includes(sel)&&on.has(r.k));$('#regd').innerHTML=sel?`<b>${G[sel][0]}</b>`+(rs.map(r=>`<div class="row"><span>${r.n}</span><b>${Math.round(EF[r.k]??v[r.k])} %</b></div>`).join('')||'<div class="mut">Aucun récepteur actif ici.</div>'):'<span class="mut">Touche une région du cerveau.</span>'}
function build(){$('#chips').innerHTML=R.map(r=>`<button class="chip${on.has(r.k)?' on':''}" data-c="${r.k}">${r.n}</button>`).join('');
$('#list').innerHTML=A().map(r=>`<div class="rc" data-n="${r.n.toLowerCase()}"><div class="rh" data-a="${r.k}"><span><i class="ar" id="a_${r.k}">▸</i>${r.n}</span><b id="v_${r.k}"></b></div><input type="range" min="0" max="100" value="${v[r.k]}" data-k="${r.k}"><div class="det hide" id="d_${r.k}"></div></div>`).join('');render()}
const S={'Cœur qui bat vite':{ne:35,b:30,crh:15},'Ventre noué':{ht3:30,crh:25,gr:15},'Énergie, envie d’agir':{dopa:30,ne:15,ox:20},'Calme profond':{gaba:30,s1a:20,ne:-25,a2:15},'Tension, mâchoire serrée':{ne:20,gr:20,gaba:-20,crh:15},'Chaleur, bien-être':{mu:30,dopa:15,oxt:15},'Fatigue, lourdeur':{ado:30,mt:20,h1:-25,ox:-25},'Légèreté, joie':{dopa:30,mu:20,s1a:15,gr:-15},'Vide, envie de pleurer':{dopa:-25,s1a:-20,kap:20,oxt:-10},'Besoin de lien':{oxt:35,dopa:10,mu:15},'Esprit embrouillé':{ach:-25,nmda:-20,ne:-10},'Concentration nette':{ach:25,a1:15,d1:15}};
const LV=[0,.4,.7,1],si={};
$('#sens').innerHTML=Object.keys(S).map(n=>`<button class="chip" data-s="${n}">${n}</button>`).join('');
const clamp=x=>Math.max(0,Math.min(100,Math.round(x))),autoOn=()=>R.forEach(r=>{if(Math.abs(v[r.k]-50)>=8)on.add(r.k)});
async function analyse(){const act=Object.entries(si).filter(x=>x[1]>0),txt=$('#txt').value.trim();
if(!act.length&&!txt){$('#msg').textContent='Choisis au moins une sensation ou décris-la.';return}
R.forEach(r=>v[r.k]=50);act.forEach(([n,l])=>{for(const k in S[n])v[k]+=S[n][k]*LV[l]});R.forEach(r=>v[r.k]=clamp(v[r.k]));autoOn();build();
$('#msg').textContent=txt?'':'Récepteurs déduits de tes sensations (règle heuristique).';
if(!txt)return;if(!sample){$('#msg').textContent='IA indisponible ici : seules les sensations ont été prises en compte.';return}
$('#msg').textContent='Analyse en cours…';
try{const o=await sample.json(`Une personne décrit ce qu'elle ressent : "${txt}". Sensations cochées : ${act.map(x=>x[0]+' ('+Math.round(LV[x[1]]*100)+' %)').join(', ')||'aucune'}.\nEstime l'activité de chaque récepteur cérébral de 0 à 100 (50 = repos), de façon plausible d'après la neurophysiologie.\nClés : ${R.map(r=>r.k+'='+r.n).join(', ')}.\nRéponds uniquement en JSON : {"values":{"dopa":50,...toutes les clés},"note":"une phrase en français"}`);
R.forEach(r=>{const x=o.values&&+o.values[r.k];v[r.k]=isFinite(x)?clamp(x):50});autoOn();build();$('#msg').textContent=o.note||'Analyse terminée.'}catch(x){$('#msg').textContent='Échec de l’analyse ('+(x&&x.code||'erreur')+').'}}
$('#go').onclick=analyse;
